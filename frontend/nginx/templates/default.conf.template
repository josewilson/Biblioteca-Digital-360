# Limite de tentativas de login por IP (LOGIN_RATE, padrão 30r/m), com folga de 10 seguidas (cabe uma turma atrás
# do mesmo IP). Passou disso: 429. Este arquivo é um modelo: o nginx troca ${LOGIN_RATE} ao subir.
limit_req_zone $binary_remote_addr zone=login:10m rate=${LOGIN_RATE};
limit_req_status 429;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # IP real do cliente quando há um proxy HTTPS na frente (docker-compose.tls.yml troca este arquivo).
    include /etc/nginx/real-ip.conf;

    # Para monitoramento externo: só diz UP ou DOWN (o detalhe do actuator não sai daqui).
    location = /healthz {
        proxy_pass http://backend:8080/actuator/health;
        access_log off;
    }

    location ~ ^/api/v1/auth/(login|forgot|reset)$ {
        limit_req zone=login burst=10 nodelay;
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 1m;
        include /etc/nginx/security-headers.conf;
    }

    # API: repassa ao backend (nome do serviço no docker compose).
    location /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # o cliente não consegue forjar: sobrescreve, não acrescenta
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        client_max_body_size 1m;
        include /etc/nginx/security-headers.conf;
    }

    # Arquivos com hash no nome: cache longo.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # Qualquer outra rota é do React Router: devolve o index.html (sem cache, para pegar versões novas).
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
        try_files $uri /index.html;
    }
}
